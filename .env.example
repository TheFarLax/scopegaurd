# --- ScopeGuard deployment / test configuration -----------------------------
# Copy to `.env` and fill in. NEVER commit the real .env (add it to .gitignore).

# Network RPC endpoint. Bradbury testnet:
GENLAYER_RPC=https://rpc-bradbury.genlayer.com

# The account that deploys and becomes the immutable `funder`.
# For the CLI (deploy/deploy.sh) this is the keystore account NAME; the CLI
# unlocks it via the OS keychain or an interactive password prompt.
GENLAYER_ACCOUNT=scopeguard

# Headless environments without an OS keychain: path (relative to the project
# root) to a 600-perm file holding the keystore password. deploy/deploy.sh feeds
# it to the CLI over stdin. Keep it under .secrets/ (gitignored).
GENLAYER_PASSWORD_FILE=.secrets/ks_pw

# For the gltest integration suite (genlayer-test), a raw private key is used
# instead (referenced as ${ACCOUNT_PRIVATE_KEY} in gltest.config.yaml).
# Leave empty unless you are running the on-network pytest suite.
ACCOUNT_PRIVATE_KEY=
